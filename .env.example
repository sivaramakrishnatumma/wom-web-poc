# Copy to .env and fill in. Read by the API server only, never sent to the browser.

# Your Azure OpenAI resource, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Deployment names (as named in Azure AI Foundry, not necessarily the model name)
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Leave empty to use the v1 API (/openai/v1/...). Set it (e.g. 2025-03-01-preview)
# to use the older deployment URLs (/openai/deployments/<name>/...?api-version=...).
AZURE_OPENAI_API_VERSION=

PORT=8787
